# Конфигурация серверного приложения платформы «Web разработчик»
PORT=3000

# Подключение к базе данных PostgreSQL (Supabase)
# При отсутствии ключей сервер автоматически использует локальное хранилище с предзаполненной БД
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Подключение к языковой модели Claude (Anthropic API)
ANTHROPIC_API_KEY=sk-ant-api03-your-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
